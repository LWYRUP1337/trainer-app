# Пример настроек для запуска backend без Docker (скопируйте в backend/.env и подставьте свои значения).
DATABASE_URL=postgresql+psycopg://trainer:change-me@localhost:5432/trainer
# Длинная случайная строка (не короче 32 символов): python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-of-32-chars-or-more
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:5173"]
# Часовой пояс для фильтра календаря по месяцу/году, отчётов и применения недельных шаблонов
DEFAULT_TIMEZONE=UTC
