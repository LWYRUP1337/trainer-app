# Скопируйте в .env (cp .env.example .env) и подставьте свои значения. Файл .env в Git не попадает.
POSTGRES_USER=trainer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trainer
# Длинная случайная строка (не короче 32 символов): python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-of-32-chars-or-more
# Порт БД на вашем компьютере (только для подключения клиентом вроде DBeaver). Если занят, поменяйте.
DB_PORT=5434
